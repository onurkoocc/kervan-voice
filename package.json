{
  "name": "kervan-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Kervan customer agent (text transcripts stand in for voice)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
